<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ESP32 Cloud Node</title>
    <!-- MQTT JavaScript Library -->
    <script src="https://unpkg.com/mqtt/dist/mqtt.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { 
            background-color: #000000; 
            color: #ffffff; 
            min-height: 100vh; 
            padding: 28px 24px; 
            display: flex; 
            flex-direction: column; 
            justify-content: space-between;
            -webkit-tap-highlight-color: transparent;
        }
        
        .header { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            padding-bottom: 20px; 
            border-bottom: 1px solid #1a1a1a; 
        }
        .brand { font-size: 0.75rem; letter-spacing: 2px; color: #71717a; font-weight: 600; text-transform: uppercase; }
        
        .status-container { display: flex; align-items: center; gap: 8px; }
        .status-text { font-size: 0.75rem; color: #71717a; }
        .status-dot { width: 8px; height: 8px; background-color: #ef4444; border-radius: 50%; transition: all 0.3s ease; }
        .status-dot.online { background-color: #22c55e; box-shadow: 0 0 8px rgba(34, 197, 94, 0.8); }

        .content { display: flex; flex-direction: column; gap: 16px; margin: auto 0; }
        
        .card { 
            background: #09090b; 
            border: 1px solid #18181b; 
            border-radius: 20px; 
            padding: 24px; 
        }
        
        .label { 
            font-size: 0.7rem; 
            letter-spacing: 1.5px; 
            color: #71717a; 
            font-weight: 600; 
            text-transform: uppercase; 
            margin-bottom: 12px; 
        }
        
        .val-group { display: flex; align-items: baseline; justify-content: space-between; }
        .num { font-size: 3.8rem; font-weight: 300; color: #ffffff; letter-spacing: -1.5px; line-height: 1; }
        .unit { font-size: 1.2rem; color: #52525b; font-weight: 400; }

        .temp-accent { color: #f97316; }
        .hum-accent { color: #38bdf8; }

        .footer { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            padding-top: 20px; 
            border-top: 1px solid #1a1a1a; 
            font-size: 0.75rem; 
            color: #52525b; 
            letter-spacing: 0.5px;
        }
        .network-type { font-family: monospace; color: #3b82f6; }
    </style>
</head>
<body>

    <div class="header">
        <span class="brand">ESP32-S3 CLOUD</span>
        <div class="status-container">
            <span class="status-text" id="status-label">Offline</span>
            <div class="status-dot" id="status-dot"></div>
        </div>
    </div>

    <div class="content">
        <div class="card">
            <div class="label">Temperature</div>
            <div class="val-group">
                <span id="temp-val" class="num">--.-</span>
                <span class="unit temp-accent">°C</span>
            </div>
        </div>

        <div class="card">
            <div class="label">Humidity</div>
            <div class="val-group">
                <span id="hum-val" class="num">--.-</span>
                <span class="unit hum-accent">%</span>
            </div>
        </div>
    </div>

    <div class="footer">
        <span>MODE</span>
        <span class="network-type">5G / Cloud MQTT</span>
    </div>

    <script>
        const client = mqtt.connect('wss://broker.hivemq.com:8884/mqtt');
        const topic = 'joke533/esp32/sensor';

        const dot = document.getElementById('status-dot');
        const label = document.getElementById('status-label');

        client.on('connect', () => {
            label.innerText = 'Connected';
            dot.classList.add('online');
            client.subscribe(topic);
        });

        client.on('message', (t, message) => {
            try {
                const data = JSON.parse(message.toString());
                document.getElementById('temp-val').innerText = data.temp.toFixed(1);
                document.getElementById('hum-val').innerText = data.hum.toFixed(1);
            } catch (e) {
                console.error("Data parse error", e);
            }
        });

        client.on('offline', () => {
            label.innerText = 'Offline';
            dot.classList.remove('online');
        });
    </script>
</body>
</html>
